---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import NewsFeed from '../../components/ui/NewsFeed.astro';
import { getCollection } from 'astro:content';

// Busca os últimos 2 posts para o resumo
const latestPosts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);

const stats = [
    { label: "Nível de Conformidade", value: "15%", color: "text-cyber-red", desc: "Crítico - Atenção Necessária" },
    { label: "Controles Implementados", value: "3/153", color: "text-white", desc: "CIS Controls v8" },
    { label: "Evidências Validadas", value: "0", color: "text-white", desc: "Aguardando Upload" },
];
---

<DashboardLayout title="Visão Geral">
    <div class="max-w-7xl mx-auto space-y-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold text-white font-jakarta">Command Center</h2>
                <p class="text-slate-400">Postura de segurança e inteligência em tempo real.</p>
            </div>
            <div class="flex gap-3">
                <button class="px-4 py-2 bg-white/5 border border-white/10 text-white text-xs font-bold rounded hover:bg-white/10 transition-all">RELATÓRIO PDF</button>
                <button class="px-4 py-2 bg-cyber-blue text-deep-space font-bold rounded text-xs hover:bg-cyan-400 transition-colors">NOVA AUDITORIA</button>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            <!-- Coluna Principal (Stats e GRC) -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- Stats Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {stats.map(stat => (
                        <div class="p-6 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur">
                            <h3 class="text-slate-500 text-[10px] font-mono uppercase mb-2">{stat.label}</h3>
                            <div class={`text-3xl font-bold font-jakarta mb-1 ${stat.color}`}>{stat.value}</div>
                            <div class="text-[10px] text-slate-500 uppercase font-mono">{stat.desc}</div>
                        </div>
                    ))}
                </div>

                <!-- Resumo Blog (Knowledge Insights) -->
                <div class="p-8 rounded-xl border border-white/5 bg-white/[0.02]">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-bold text-white font-jakarta uppercase tracking-tight">Intelligence Insights</h3>
                        <a href="/blog" class="text-xs text-cyber-blue hover:underline">Ver todos</a>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        {latestPosts.map(post => (
                            <a href={`/blog/${post.slug}`} class="block p-5 rounded-lg border border-white/5 bg-black/20 hover:border-cyber-blue/30 transition-all group">
                                <div class="text-[10px] font-mono text-slate-500 mb-2 uppercase">{post.data.tags[0]}</div>
                                <h4 class="text-white font-bold text-sm group-hover:text-cyber-blue mb-2 transition-colors">{post.data.title}</h4>
                                <p class="text-slate-500 text-xs line-clamp-2">{post.data.description}</p>
                            </a>
                        ))}
                    </div>
                </div>

                <!-- Ações Prioritárias -->
                <div class="p-8 rounded-xl border border-white/5 bg-white/[0.02]">
                    <h3 class="text-lg font-bold text-white font-jakarta mb-6 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-cyber-red animate-pulse"></span>
                        Prioridades de Implementação (IG1)
                    </h3>
                    <div class="space-y-3">
                        {[1, 2].map(i => (
                            <div class="flex items-center justify-between p-4 rounded bg-black/40 border border-white/5">
                                <div class="flex items-center gap-4">
                                    <div class="w-8 h-8 rounded bg-white/5 flex items-center justify-center text-[10px] font-mono text-slate-400">1.{i}</div>
                                    <div>
                                        <h4 class="text-white text-sm font-medium">Controle de Ativos de Hardware</h4>
                                        <p class="text-[10px] text-slate-500 uppercase font-mono tracking-tighter">Status: Pendente • Impacto: Alto</p>
                                    </div>
                                </div>
                                <button class="text-[10px] font-bold text-cyber-blue border border-cyber-blue/20 px-3 py-1 rounded hover:bg-cyber-blue/10 transition-all">MITIGAR</button>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Coluna Lateral (NewsFeed) -->
            <div class="space-y-8">
                <div class="p-6 rounded-xl border border-white/5 bg-white/[0.02] h-full">
                    <NewsFeed />
                    
                    <!-- Dica da Kortana (Widget) -->
                    <div class="mt-10 p-5 rounded-lg bg-cyber-blue/5 border border-cyber-blue/10 relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 opacity-10">
                             <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyber-blue"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
                        </div>
                        <h4 class="text-cyber-blue text-xs font-bold font-jakarta mb-2">KORTANA_INSIGHT</h4>
                        <p class="text-slate-400 text-[11px] leading-relaxed">
                            "Comandante, a vulnerabilidade no Kernel Linux citada ao lado pode afetar 40% da nossa infraestrutura atual. Recomendo auditoria no Controle 1.2 imediata."
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</DashboardLayout>
